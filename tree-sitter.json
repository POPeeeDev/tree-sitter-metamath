{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "metamath",
      "camelcase": "Metamath",
      "title": "Metamath",
      "scope": "source.metamath",
      "file-types": [ "mm", "ok.mm", "err.mm" ],
      "injection-regex": "^metamath$",
      "first-line-regex": "(\\$\\(|\\$c|\\$v).*",
      "class-name": "Metamath"
    }
  ],
  "metadata": {
    "version": "1.0.1",
    "license": "CC0-1.0",
    "description": "Tree-sitter grammar for Metamath proof language",
    "authors": [
      {
        "name": "POPeeeDev",
        "url": "https://github.com/POPeeeDev"
      }
    ],
    "links": {
      "repository": "https://github.com/POPeeeDev/tree-sitter-metamath"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": true
  }
}
